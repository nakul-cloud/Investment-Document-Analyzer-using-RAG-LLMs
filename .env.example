# Groq LLM API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Local Vector & Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Security & JWT Configuration (Generate a secure random key in production)
SECRET_KEY=supersecretkeychangethisinproduction1234567890!
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database Configuration (aiosqlite is used for asynchronous SQLite operations)
DATABASE_URL=sqlite+aiosqlite:///./doc_analyzer.db

# Middleware Settings
RATE_LIMIT_CALLS=20
